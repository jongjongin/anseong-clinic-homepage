NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
AUTH_EMAIL=admin@anseong365.com
AUTH_PASSWORD=change-this-password
AUTH_SECRET=change-this-secret

# 온라인 상담 예약 (둘 중 하나만 설정해도 접수 동작, 둘 다 권장)
# Neon Postgres 연결 문자열 (Vercel Marketplace → Neon 연동 시 자동 발급)
DATABASE_URL=
# Resend 이메일 알림 (https://resend.com API 키)
RESEND_API_KEY=
# 신청 알림을 받을 병원 이메일
RESERVATION_NOTIFY_EMAIL=
# 발신 주소 (Resend에서 인증한 도메인 주소, 없으면 onboarding@resend.dev)
RESERVATION_FROM_EMAIL=
# 슬랙 알림 — 방법 1 (권장): 봇 토큰 + 채널 ID
# 기존 슬랙 앱(경희365봇)의 OAuth & Permissions에서 발급한 Bot User OAuth Token
SLACK_BOT_TOKEN=
# 알림을 받을 채널 ID (슬랙 채널 > 채널 정보 맨 아래에 표시)
SLACK_CHANNEL_ID=
# 슬랙 알림 — 방법 2 (대체): Incoming Webhook URL
SLACK_WEBHOOK_URL=
